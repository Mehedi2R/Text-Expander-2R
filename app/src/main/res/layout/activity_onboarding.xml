<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingHorizontal="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- App Logo -->
            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/app_logo"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/app_name" />

            <!-- Welcome Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Welcome to Text Expander 2R"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- Subtitle Tagline -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Create custom keywords that expand into snippets, templates, or repetitive text anywhere you type."
                android:textSize="13.5sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="2dp" />

            <!-- Beautiful Structured Info Highlights -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_info_pill_box"
                android:padding="10dp"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="100% Offline &amp; Private — All data is stored locally and never shared."
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="1.5dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="100% Offline &amp; No Internet — Operates strictly on-device without internet access or data transmission."
                        android:textSize="12sp"
                        android:textColor="@color/text_tertiary"
                        android:lineSpacingExtra="1.5dp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="14dp" />

            <!-- Card 1: Allow run in background -->
            <LinearLayout
                android:id="@+id/cardAllowBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_onboarding_card_1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/iconContainerBg"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_arrow">
                    <ImageView
                        android:id="@+id/imgArrowBg"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#FFFFFF"
                        android:contentDescription="Action" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitleBg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Allow run in background"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvSubtitleBg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Prevents Android from stopping background service"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Enable accessibility service -->
            <LinearLayout
                android:id="@+id/cardEnableAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_onboarding_card_2"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/iconContainerAcc"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_arrow_outline">
                    <ImageView
                        android:id="@+id/imgArrowAcc"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/primary"
                        android:contentDescription="Action" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitleAcc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable accessibility service"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvSubtitleAcc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Allows the app to expand keywords into text"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Restricted setting Guide (Collapsed by default) -->
            <LinearLayout
                android:id="@+id/cardRestrictedFix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_restricted_card"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <!-- Header / Toggle Row -->
                <LinearLayout
                    android:id="@+id/btnToggleRestrictedGuide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_warning">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warning"
                            app:tint="#F59E0B"
                            android:contentDescription="Restricted setting" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTitleRestricted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Restricted setting"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#F59E0B" />

                        <TextView
                            android:id="@+id/tvSubtitleRestricted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Service blocked on Android 13+? Tap for guide"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgArrowRestricted"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- Expandable Guide Content (Collapsed by default) -->
                <LinearLayout
                    android:id="@+id/layoutRestrictedDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="8dp" />

                    <!-- Short easy steps -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="If Android blocks this service, follow 3 steps:"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="5dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1. Tap 'Open App Info' button below."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2. Tap the 3 dots (⋮) in the top-right corner."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3. Tap 'Allow restricted settings' and confirm."
                            android:textSize="12sp"
                            android:textColor="#F59E0B"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Direct Open App Info Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenAppInfo"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="Open App Info"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#1F2937"
                        app:strokeColor="#374151"
                        app:strokeWidth="1dp" />

                    <!-- A2 Guide Image with Rounded Frame -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_image_frame"
                        android:padding="3dp">

                        <ImageView
                            android:id="@+id/imgGuideRestricted"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/guide_restricted_settings"
                            android:contentDescription="Allow restricted settings guide image" />
                    </FrameLayout>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Continue"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#0B0E14"
        app:cornerRadius="24dp"
        app:backgroundTint="@color/primary" />

</LinearLayout>
