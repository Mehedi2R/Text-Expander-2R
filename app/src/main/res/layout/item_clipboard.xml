<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_shortcut_card"
    android:animateLayoutChanges="true"
    android:paddingHorizontal="14dp"
    android:paddingVertical="11dp">

    <!-- Copied Text Content -->
    <TextView
        android:id="@+id/tvClipboardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="14.5sp"
        android:textStyle="normal"
        android:lineSpacingExtra="3.5dp"
        android:maxLines="3"
        android:ellipsize="end"
        tools:text="GEN BIN - 51546200200\n52649801047\n526226..." />

    <!-- Action Row (Copy, Create Snippet, Count) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <!-- Copy Action Icon -->
        <ImageView
            android:id="@+id/btnCopyClipboardItem"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_copy"
            android:contentDescription="Copy"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/primary" />

        <!-- Convert to Shortcut / Snippet icon -->
        <ImageView
            android:id="@+id/btnConvertToShortcut"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="14dp"
            android:padding="4dp"
            android:src="@drawable/ic_tab_text"
            android:contentDescription="Create Shortcut"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Copy count badge (e.g. 1x) -->
        <TextView
            android:id="@+id/tvClipboardCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-medium"
            tools:text="1x" />
    </LinearLayout>

</LinearLayout>
