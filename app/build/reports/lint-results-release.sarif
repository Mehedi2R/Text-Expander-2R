                {
                    "ruleId": "ClickableViewAccessibility",
                    "ruleIndex": 0,
                    "message": {
                        "text": "onTouch lambda should call View#performClick when a click is detected",
                        "markdown": "`onTouch` lambda should call `View#performClick` when a click is detected"
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uriBaseId": "%SRCROOT%",
                                    "uri": "app/src/main/java/com/textexpander/app/service/TextExpanderAccessibilityService.kt"
                                },
                                "region": {
                                    "startLine": 664,
                                    "startColumn": 54,
                                    "endLine": 689,
                                    "endColumn": 14,
                                    "charOffset": 26679,
                                    "charLength": 1209,
                                    "snippet": {
                                        "text": "{ v, event ->\n                when (event.actionMasked) {\n                    MotionEvent.ACTION_DOWN -> {\n                        downY = event.rawY\n                        downX = event.rawX\n                        isScrolling = false\n                    }\n                    MotionEvent.ACTION_MOVE -> {\n                        val dy = kotlin.math.abs(event.rawY - downY)\n                        val dx = kotlin.math.abs(event.rawX - downX)\n                        if (dy > touchSlop * 1.5f || dx > touchSlop * 1.5f) {\n                            isScrolling = true\n                        }\n                    }\n                    MotionEvent.ACTION_UP -> {\n                        val dy = kotlin.math.abs(event.rawY - downY)\n                        val dx = kotlin.math.abs(event.rawX - downX)\n                        if (!isScrolling && dy < touchSlop * 2f && dx < touchSlop * 2f) {\n                            // User selected/tapped text -> input with vibration!\n                            onFloatingSuggestionTapped()\n                            return@setOnTouchListener true\n                        }\n                    }\n                }\n                v.onTouchEvent(event)\n            }"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 662,
                                    "endLine": 692,
                                    "snippet": {
                                        "text": "            tvSuggestionText?.isFocusable = false\n\n            scrollSuggestionText?.setOnTouchListener { v, event ->\n                when (event.actionMasked) {\n                    MotionEvent.ACTION_DOWN -> {\n                        downY = event.rawY\n                        downX = event.rawX\n                        isScrolling = false\n                    }\n                    MotionEvent.ACTION_MOVE -> {\n                        val dy = kotlin.math.abs(event.rawY - downY)\n                        val dx = kotlin.math.abs(event.rawX - downX)\n                        if (dy > touchSlop * 1.5f || dx > touchSlop * 1.5f) {\n                            isScrolling = true\n                        }\n                    }\n                    MotionEvent.ACTION_UP -> {\n                        val dy = kotlin.math.abs(event.rawY - downY)\n                        val dx = kotlin.math.abs(event.rawX - downX)\n                        if (!isScrolling && dy < touchSlop * 2f && dx < touchSlop * 2f) {\n                            // User selected/tapped text -> input with vibration!\n                            onFloatingSuggestionTapped()\n                            return@setOnTouchListener true\n                        }\n                    }\n                }\n                v.onTouchEvent(event)\n            }\n\n            tvSuggestionKey?.setOnClickListener {\n"
                                    }
                                }
                            }
                        }
                    ],
                    "partialFingerprints": {
                        "sourceContext/v1": "2a37fe25bd85ff8e"
                    }
                },
