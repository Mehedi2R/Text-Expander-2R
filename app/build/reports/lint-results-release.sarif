                                        "text": "            }\n\n            view.setOnTouchListener { _, touchEvent ->\n                if (touchEvent.action == MotionEvent.ACTION_OUTSIDE) {\n                    hideFloatingSuggestion()\n                    true\n                } else {\n                    false\n                }\n            }\n        } catch (e: Exception) {\n            Log.e(TAG, \"Failed to init floating view\", e)\n"
                                    }
