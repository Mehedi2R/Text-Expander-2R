    <string name="accessibility_service_description">Text Expander 2R uses the Accessibility Service solely to detect user-defined shortcuts and expand them into text snippets. It operates 100% offline and never collects, records, or transmits keystrokes, personal data, or passwords.</string>
    <string name="add_shortcut">Add Shortcut</string>
    <string name="app_name">Text Expander 2R</string>
    <string name="cancel">Cancel</string>
    <string name="delete">Delete</string>
    <string name="delete_shortcut_confirm">Are you sure you want to delete shortcut \"%1$s\"?</string>
    <string name="edit_shortcut">Edit Shortcut</string>
    <string name="paste_clipboard">Paste Clipboard</string>
    <style name="Theme.TextExpander" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#0B0E14</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:colorBackground">@color/background</item>
    </style>
    <style name="Theme.TextExpander.InstantPage" parent="Theme.TextExpander">
        <item name="android:windowAnimationStyle">@style/WindowNoAnimation</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="WindowNoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
    </style>
